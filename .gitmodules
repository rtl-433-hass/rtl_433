[submodule "tests/integration/rtl_433_tests"]
	path = tests/integration/rtl_433_tests
	url = https://github.com/merbanan/rtl_433_tests
	shallow = true
	# NOTE: `sparse-checkout` is NOT part of the .gitmodules schema -- git ignores
	# it, so `git submodule update --init` still downloads all ~1.5 GB of the
	# upstream repo. It is kept here only to document which directories are
	# wanted. `scripts/fetch_captures.sh` is what actually performs a blobless,
	# sparse checkout (~13 MB) and owns the authoritative path list; use it
	# instead of initializing this submodule directly.
	sparse-checkout = tests/acurite/Acurite_592TXR tests/acurite/Acurite_606TX tests/scmplus/01 tests/ert/scm/01
	update = none
